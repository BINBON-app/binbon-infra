locals {
  environment="prod"
 region="eu-central-1"
 account_id="123456789012"
 domain_name=null
 route53_zone_id=null
  alb_certificate_arn=null
 cloudfront_certificate_arn=null
  opensearch={
    instance_type="r6g.large.search"
    instance_count=3
    volume_size_gb=100
  }
  clickhouse={
    region="eu-central-1"
    num_replicas=3
    min_replica_memory_gb=16
    max_replica_memory_gb=32
    idle_scaling=false
    password_wo_version=1
  }
  services={
api-gateway={image="123456789012.dkr.ecr.eu-central-1.amazonaws.com/binbon/api-gateway:replace",container_port=8080,cpu=1024,memory=2048,desired_count=3,min_count=3,max_count=20,path_patterns=["/api/*"],environment={APP_ENV="prod"
},secret_arns={REDPANDA_SASL_PASSWORD="arn:aws:secretsmanager:eu-central-1:123456789012:secret:binbon-prod-redpanda-api-gateway"
},redpanda_user="api-gateway",task_policy_json=null
} 
}
  keyspaces_tables={
}
  cognito={
    hosted_domain_prefix="binbon-prod-123456789012"
    custom_domain=null
    custom_domain_certificate_arn=null
    callback_urls=["https://app.example.com/callback"]
    logout_urls=["https://app.example.com/"]
    mfa_configuration="ON"
    allow_self_signup=true
    generate_client_secret=false
    create_identity_pool=false
    groups={users={description="Default users",precedence=100
},moderators={description="Moderators",precedence=50
},admins={description="Administrators",precedence=1
}
}
    api_scopes={read="Read application data",write="Write application data"
}
    lambda_triggers={
}
  
}
  redpanda={
    region="eu-central-1"
    enable_private_link=true
    public_networking="STATE_DISABLED"
    private_networking="STATE_ENABLED"
    allow_cluster_deletion=false
    allow_private_link_deletion=false
    allow_topic_deletion=false
    topics={
"user-events"={partitions=6,configuration={"cleanup.policy"="delete","retention.ms"="2592000000"
}
},notifications={partitions=6,configuration={"cleanup.policy"="delete","retention.ms"="1209600000"
}
} 
}
    service_users={
"api-gateway"={password_wo_version=1,topic_permissions={"user-events"=["WRITE","DESCRIBE"],notifications=["WRITE","DESCRIBE"]
},group_permissions={
},cluster_permissions=[]
} 
}
  
}
}
