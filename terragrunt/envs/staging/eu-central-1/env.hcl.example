locals {
  environment="staging"
 region="eu-central-1"
 account_id="123456789012"
 domain_name=null
 route53_zone_id=null
  alb_certificate_arn=null
 cloudfront_certificate_arn=null
  opensearch={
    instance_type="t3.medium.search"
    instance_count=2
    volume_size_gb=20
  }
  clickhouse={
    region="eu-central-1"
    num_replicas=1
    min_replica_memory_gb=8
    max_replica_memory_gb=8
    idle_scaling=true
    password_wo_version=1
  }
  services={
api-gateway={image="123456789012.dkr.ecr.eu-central-1.amazonaws.com/binbon-staging:api-gateway-replace",container_port=8080,cpu=512,memory=1024,desired_count=2,min_count=2,max_count=6,path_patterns=["/api/*"],environment={APP_ENV="staging"
},secret_arns={REDPANDA_SASL_PASSWORD="arn:aws:secretsmanager:eu-central-1:123456789012:secret:binbon-staging-redpanda-api-gateway"
},redpanda_user="api-gateway",task_policy_json=null
} 
}
  keyspaces_tables={
}
  redpanda={
    region="eu-central-1"
    enable_private_link=true
    public_networking="STATE_DISABLED"
    private_networking="STATE_ENABLED"
    allow_cluster_deletion=false
    allow_private_link_deletion=false
    allow_topic_deletion=false
    topics={
"user-events"={partitions=3,configuration={"cleanup.policy"="delete","retention.ms"="1209600000"
}
},notifications={partitions=3,configuration={"cleanup.policy"="delete","retention.ms"="604800000"
}
} 
}
    service_users={
"api-gateway"={password_wo_version=1,topic_permissions={"user-events"=["WRITE","DESCRIBE"],notifications=["WRITE","DESCRIBE"]
},group_permissions={
},cluster_permissions=[]
} 
}
  
}
}
